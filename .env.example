# =================================================================
# LUMIÈRE Platform Environment Configuration Template
# COPY this file to .env before running: cp .env.example .env
# NEVER commit the real .env file to version control!
# =================================================================

# Server Port & Environment
PORT=4000
NODE_ENV=production

# -----------------------------------------------------------------
# SECURITY: JSON Web Token Secret Key
# Generate a cryptographically secure 64-character hex key:
#   Using Node.js:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Using OpenSSL:  openssl rand -hex 32
# -----------------------------------------------------------------
JWT_SECRET=replace_with_generated_64_character_hex_key

# -----------------------------------------------------------------
# INITIAL ADMIN CREDENTIALS
# Configure these BEFORE first startup. The system will seed the admin
# account from these values on the first run only.
# -----------------------------------------------------------------
ADMIN_EMAIL=owner@yourdomain.com
ADMIN_PASSWORD=change_this_to_a_secure_password_min_12_chars

# Database Storage Path (SQLite)
DATABASE_FILE=./data/lumiere.db

# -----------------------------------------------------------------
# CORS: Allowed Origins for cross-domain frontend/backend deployments
# -----------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# -----------------------------------------------------------------
# PASSWORD RESET: public base URL used to build reset links
# (e.g. https://your-store.onrender.com). Falls back to the request's
# own host if not set.
# -----------------------------------------------------------------
PUBLIC_URL=

# Optional SMTP settings to actually deliver reset-password emails.
# Without these, reset links are only printed to the server console —
# fine for local testing, NOT sufficient for a real customer-facing store.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# -----------------------------------------------------------------
# GOOGLE SIGN-IN (customer login)
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console
# and set your deployed domain as an authorized JavaScript origin.
# Leave empty to disable the "Continue with Google" button entirely.
# -----------------------------------------------------------------
GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------
# MOYASAR: card payments (Mada, Visa, Mastercard) for the Saudi market
# Get your keys from https://dashboard.moyasar.com after creating a
# merchant account. Leave MOYASAR_SECRET_KEY empty to keep the store
# COD-only — the "pay by card" option stays hidden automatically.
# -----------------------------------------------------------------
MOYASAR_SECRET_KEY=
# Set this to the same secret you configure in the Moyasar dashboard's
# webhook settings — required to verify that webhook calls really come
# from Moyasar and not a forged request.
MOYASAR_WEBHOOK_SECRET=
